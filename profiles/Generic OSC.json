{
  "name": "Generic OSC",
  "connection": {
    "type": "generic",
    "host": "127.0.0.1",
    "port": 8000,
    "prefix": "",
    "listen_port": 9000,
    "fader_type": "i",
    "generic": {
      "fader": "/fader/{n}",
      "key": "/key/{n}",
      "encoder": "/encoder/{n}",
      "push": "/encoder/{n}/push",
      "button": "/button/{n}",
      "page": "/page",
      "command": "/command"
    }
  },
  "faders": [
    {
      "name": "F1",
      "color": "e0a020"
    },
    {
      "name": "F2",
      "feedback": "/mixer/ch2/level"
    },
    {
      "name": "F3"
    },
    {
      "name": "F4"
    },
    {
      "name": "F5",
      "osc": "/master/level"
    }
  ],
  "keys": [
    {
      "osc": "/go"
    },
    {
      "osc": "/stop"
    },
    {
      "osc": "/key/3"
    },
    {
      "osc": "/key/4"
    },
    {
      "osc": "/key/5"
    },
    {
      "osc": "/key/6"
    },
    {
      "osc": "/key/7"
    },
    {
      "osc": "/key/8"
    },
    {
      "osc": "/key/9"
    },
    {
      "osc": "/key/10"
    },
    {
      "osc": "/key/11"
    },
    {
      "osc": "/key/12"
    },
    {
      "osc": "/key/13"
    },
    {
      "osc": "/key/14"
    },
    {
      "osc": "/key/15"
    },
    {
      "osc": "/key/16"
    },
    {
      "osc": "/key/17"
    },
    {
      "osc": "/key/18"
    },
    {
      "osc": "/key/19"
    },
    {
      "osc": "/key/20"
    }
  ],
  "encoders": [
    {
      "label": "Speed"
    },
    {
      "label": "Size",
      "value": "/size/display"
    }
  ],
  "touch_buttons": [
    {
      "label": "Go",
      "osc": "/go",
      "lit": "/go/running",
      "color": "1f7a3a"
    },
    {
      "label": "Stop",
      "osc": "/stop",
      "lit_color": "c03030"
    },
    {
      "label": "Back",
      "osc": "/back"
    },
    {
      "label": "Keypad",
      "screen": "keypad"
    },
    {
      "label": "Encoders",
      "screen": "encoders"
    }
  ],
  "encoder_attributes": [
    "Dimmer",
    "Pan",
    "Tilt",
    "Zoom",
    "Focus1",
    "Iris",
    "Shutter1",
    "Gobo1",
    "Color1",
    "Prism1",
    "Frost1"
  ],
  "pickup": true,
  "screen": {
    "left": "{profile}",
    "middle": "sent",
    "status": "osc",
    "encoders": "simple",
    "encoders_title": "Encoders",
    "encoder_strip": true,
    "colors": {
      "background": "101418",
      "panel": "1c2430",
      "button": "2c3546",
      "button_lit": "c08a1e",
      "bar": "2f7de1",
      "bar_background": "232b38",
      "text": "ffffff"
    }
  },
  "feedback": {
    "fader": "/fader/{n}",
    "fader_name": "/fader/{n}/name",
    "fader_color": "/fader/{n}/color",
    "button": "/button/{n}/state",
    "button_label": "/button/{n}/label",
    "encoder_label": "/encoder/{n}/label",
    "encoder_value": "/encoder/{n}/value",
    "text": "/text",
    "status": "/status",
    "page": "/page"
